APP_NAME="Datafront Back"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://datafrontback.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Orígenes del frontend (datafront, Vite) autorizados para CORS
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Binarios de los motores de IA que clasifican las capturas.
# El PHP de Herd no hereda /opt/homebrew/bin en su PATH, por eso van rutas
# absolutas. Comprueba las tuyas con `which claude` y `which codex`.
VAULT_CLAUDE_BIN=/opt/homebrew/bin/claude
VAULT_CODEX_BIN=/opt/homebrew/bin/codex

# Bandeja de entrada sincronizada con el homelab (Syncthing).
# La carpeta puede no existir todavía: la API lo reporta sin romperse.
VAULT_INBOX_PATH=/Users/armandoreyesrivera/Sync/datafront-inbox
VAULT_INBOX_SETTLE=20

# Python con Pillow para el dHash (filtro de gusto del homelab).
VAULT_PYTHON_BIN=/usr/bin/python3
